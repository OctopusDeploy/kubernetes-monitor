# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Local IDE state
.idea/

# Generated Configuration files
configuration/
cert.pem
key.pem

# Test logs
test-cluster-logs/

# Heap dumps produced by the memory profile tests
testdata/memory-profiles/
*.pprof

# etcd snapshots consumed by the memory profile test — regenerate locally with
# the snapshot_gen build tag. Too large to commit.
kwok_integration/testdata/snapshots/

# OS related files
*.DS_Store
**/*.DS_Store

node_modules

.debug/

# AI assistant files
.claude/
.gemini/

bin

# Local credentials and environment overrides
.env
.env.*
*.key
*.p12
*.pfx
.kube/

# Local build, test, and profiling output
dumps/
results/
artifacts/
coverage/
*.tgz
