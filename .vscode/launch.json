{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "register-k8s",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}",
      "args": [
        "register",
        "--debug",
        "--use-kubeconfig",
        "--space-id=${input:registrationSpaceId}",
        "--server-api-url=${input:serverApiUrl}",
        "--config-store=kubernetes",
        "--kubernetes-store-prefix=${input:kubernetesStorePrefix}",
        "--kubernetes-store-namespace=${input:kubernetesStoreNamespace}",
        "--machine-name=${input:machineName}"
      ]
    },
    {
      "name": "register",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}",
      "args": [
        "register",
        "--debug",
        "--use-kubeconfig",
        "--space-id=${input:registrationSpaceId}",
        "--server-api-url=${input:serverApiUrl}",
        "--machine-name=${input:machineName}",
        "--config-path=configuration/${input:configName}/"
      ]
    },
    {
      "name": "run",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceRoot}",
      "args": [
        "--use-kubeconfig",
        "--config-path=configuration/${input:configName}/"
      ]
    }
  ],
  "inputs": [
    {
      "id": "machineName",
      "type": "promptString",
      "description": "Machine name to register the monitor for",
      "default": ""
    },
    {
      "id": "kubernetesStorePrefix",
      "type": "promptString",
      "description": "Prefix for the Kubernetes configuration and authentication objects",
      "default": "kubernetes-monitor"
    },
    {
      "id": "kubernetesStoreNamespace",
      "type": "promptString",
      "description": "Namespace for the Kubernetes configuration and authentication objects",
      "default": "default"
    },
    {
      "id": "configName",
      "type": "promptString",
      "description": "Name for the configuration folder",
      "default": "default"
    },
    {
      "id": "serverApiUrl",
      "type": "promptString",
      "description": "Octopus server API URL",
      "default": "http://localhost:8065"
    },
    {
      "id": "registrationSpaceId",
      "type": "promptString",
      "description": "Space ID the monitor should be registered in",
      "default": "Spaces-1"
    }
  ]
}