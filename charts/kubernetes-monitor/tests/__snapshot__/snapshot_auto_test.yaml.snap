should match snapshot for automatic registration:
  1: |
    raw: ""
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: kubernetes-monitor-chart
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: kubernetes-monitor-chart-1.2.3
      name: release-name-kubernetes-monitor-chart-binding
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: release-name-kubernetes-monitor-chart-role
    subjects:
      - kind: ServiceAccount
        name: release-name-kubernetes-monitor-chart
        namespace: NAMESPACE
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: kubernetes-monitor-chart
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: kubernetes-monitor-chart-1.2.3
      name: release-name-kubernetes-monitor-chart-role
    rules:
      - apiGroups:
          - '*'
        resources:
          - '*'
        verbs:
          - get
          - watch
          - list
  4: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: kubernetes-monitor-chart
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: kubernetes-monitor-chart-1.2.3
      name: release-name-kubernetes-monitor-chart
      namespace: NAMESPACE
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: kubernetes-monitor-chart
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: kubernetes-monitor-chart
            app.kubernetes.io/version: 4.5.6
            helm.sh/chart: kubernetes-monitor-chart-1.2.3
        spec:
          containers:
            - env:
                - name: SERVER_GRPC_URL
                  value: server-grpc-url
              envFrom:
                - secretRef:
                    name: release-name-kubernetes-monitor-chart-authentication
              image: docker.io/octopusdeploy/kubernetes-monitor:v4.5.6
              imagePullPolicy: IfNotPresent
              name: monitor
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
          nodeSelector:
            kubernetes.io/os: linux
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: release-name-kubernetes-monitor-chart
  5: |
    apiVersion: v1
    automountServiceAccountToken: true
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: kubernetes-monitor-chart
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: kubernetes-monitor-chart-1.2.3
      name: release-name-kubernetes-monitor-chart
      namespace: NAMESPACE
  6: |
    apiVersion: v1
    kind: Pod
    metadata:
      annotations:
        helm.sh/hook: pre-upgrade,pre-install
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: kubernetes-monitor-chart
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: kubernetes-monitor-chart-1.2.3
      name: release-name-kubernetes-monitor-chart-registration
      namespace: NAMESPACE
    spec:
      containers:
        - args:
            - register
          command:
            - /monitor
          env:
            - name: SERVER_ACCESS_TOKEN
              valueFrom:
                secretKeyRef:
                  key: SERVER_ACCESS_TOKEN
                  name: release-name-kubernetes-monitor-chart-registration
            - name: CONFIG_STORE
              value: kubernetes
            - name: SERVER_API_URL
              value: api-url-here
            - name: MACHINE_NAME
              value: machine-name
            - name: SPACE_ID
              value: spaces-1
            - name: KUBERNETES_STORE_PREFIX
              value: release-name-kubernetes-monitor-chart
            - name: KUBERNETES_STORE_NAMESPACE
              value: NAMESPACE
          envFrom:
            - secretRef:
                name: release-name-kubernetes-monitor-chart-authentication
                optional: true
          image: docker.io/octopusdeploy/kubernetes-monitor:v4.5.6
          imagePullPolicy: IfNotPresent
          name: registration
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            readOnlyRootFilesystem: true
      nodeSelector:
        kubernetes.io/os: linux
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      serviceAccountName: release-name-kubernetes-monitor-chart-registration
  7: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      annotations:
        helm.sh/hook: pre-upgrade,pre-install
        helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
        helm.sh/hook-weight: "-5"
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: kubernetes-monitor-chart
        app.kubernetes.io/version: 4.5.6
        helm.sh/chart: kubernetes-monitor-chart-1.2.3
      name: release-name-kubernetes-monitor-chart-registration-role
      namespace: NAMESPACE
    rules:
      - apiGroups:
          - ""
        resources:
          - secrets
        verbs:
          - get
          - list
          - create
          - update
