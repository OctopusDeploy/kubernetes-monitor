{
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "pull-request-title-pattern": "feat${scope}: release${component} ${version}",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "release-type": "go",
      "versioning": "default",
      "exclude-paths": [
        "charts/kubernetes-monitor"
      ],
      "extra-files": [
        {
          "type": "yaml",
          "path": "charts/kubernetes-monitor/Chart.yaml",
          "jsonpath": "$.appVersion"
        }
      ]
    },
    "charts/kubernetes-monitor": {
      "component": "kubernetes-monitor-chart",
      "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "release-type": "helm",
      "versioning": "default"
    }
  }
}